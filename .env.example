# =================================================================
# NIGRAANI AI — PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION
# =================================================================

# 1. Environment & Node Settings
NODE_ENV=production
PORT=3000

# 2. Production Database (MySQL 8.0+ compatible: PlanetScale, TiDB, Aiven, Railway, AWS RDS)
DATABASE_URL=mysql://<user>:<password>@<host>:<port>/<dbname>?ssl={"rejectUnauthorized":true}

# 3. Security & Authentication
JWT_SECRET=generate-a-strong-random-secret-for-jwt-signing
COOKIE_SECRET=generate-a-strong-random-cookie-secret

# 4. OAuth Configuration (if external OAuth is enabled)
OAUTH_SERVER_URL=https://auth.example.com
VITE_APP_ID=nigraani-ai
OWNER_OPEN_ID=admin-central-mospi

# 5. Persistent File & Evidence Storage (AWS S3 / Cloudflare R2 / Supabase Storage)
# In production, files should be stored in S3-compatible cloud storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=nigraani-evidence-production
AWS_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# 6. Optional: Forge Storage (if deploying in Forge environment)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
