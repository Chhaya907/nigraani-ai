{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "server/**",
        "shared/**",
        "drizzle/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/evidence/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api|uploads|evidence).*)",
      "destination": "/index.html"
    }
  ]
}